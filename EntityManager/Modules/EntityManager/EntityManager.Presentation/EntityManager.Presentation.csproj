<!-- PURPOSE: the Presentation layer - HTTP endpoint definitions only. A
     plain class library (not a Web SDK project) that pulls in ASP.NET Core's
     types via FrameworkReference, since it defines endpoints but isn't
     itself a runnable app - Host/EntityManager.Api is what actually runs. -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EntityManager.Application\EntityManager.Application.csproj" />
    <ProjectReference Include="..\..\..\Shared\Infrastructure\Ag.Cache\Ag.Cache.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Mediator.Abstractions" Version="3.0.2" />
    <!-- Only used by SandboxTestEndpoints.cs, a sandbox-only test endpoint -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.0.2" />
  </ItemGroup>

</Project>
