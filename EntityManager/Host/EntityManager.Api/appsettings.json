{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "IDC_ETY": "--not-using-now--server=<REAL_DB_SERVER>;UID=<REAL_DB_USER>;PWD=<REAL_DB_PASSWORD>;database=idc_ety;Pooling=true;Min Pool Size=5;Max Pool Size=20;Connection Timeout=30;TrustServerCertificate=True;",
    "IDC_ETY_SANDBOX": "Server=(localdb)\\MSSQLLocalDB;Database=idc_ety_sandbox;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "UseSandboxDb": true,
  "CDN": { "Url": "https://cdn.datafloat.com/" },
  "Redis": {
    "Host": "127.0.0.1",
    "Port": 6379,
    "Password": "",
    "Ssl": false
  }
}
