<!-- PURPOSE: a one-time (re-runnable) console tool that creates a fully local,
     full-CRUD copy of the real Agent/Office/Company data on SQL Server
     LocalDB - so you can test real writes triggering watcher.js-style
     invalidation without ever touching real production. Reuses the same
     EntityManagerDbContext/entities as the real API, so the sandbox schema
     is guaranteed to match exactly. -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Modules\EntityManager\EntityManager.Infrastructure\EntityManager.Infrastructure.csproj" />
  </ItemGroup>

</Project>
